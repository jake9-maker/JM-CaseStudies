---
// src/pages/404.astro - Shown by GitHub Pages for any address that doesn't exist
import BaseLayout from '../layouts/BaseLayout.astro';
const baseUrl = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Page not found · Jake Maisel"
  description="This page doesn't exist. See Jake Maisel's brand and product work instead.">
  <section class="page-hero not-found">
    <div class="page-hero-inner">
      <p class="eyebrow">404</p>
      <h1>This page broke its <em>promise</em>.</h1>
      <p class="lede">The link may be old or mistyped. The work is all still here.</p>
      <div class="actions">
        <a href={`${baseUrl}work/`} class="btn btn-primary">See the work</a>
        <a href={`${baseUrl}`} class="btn btn-ghost">Go home</a>
        <a href={`${baseUrl}contact/`} class="btn btn-ghost">Get in touch</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .not-found {
    min-height: 62vh;
    display: flex;
    align-items: center;
  }

  .not-found .page-hero-inner {
    width: 100%;
  }

  .actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }
</style>
