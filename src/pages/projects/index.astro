---
// The projects list now lives on the combined Work page. Kept as a redirect so old links still work.
const target = `${import.meta.env.BASE_URL}work/#product`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL('/work/', Astro.site).toString()} />
    <title>Work · Jake Maisel</title>
  </head>
  <body>
    <p>This page moved to <a href={target}>Work</a>.</p>
  </body>
</html>
