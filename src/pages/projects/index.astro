---
// src/pages/projects/index.astro - Projects listing page
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactCTA from '../../components/ContactCTA.astro';

const baseUrl = import.meta.env.BASE_URL;

// Get all projects, strongest first (same order as the homepage)
const projects = (await getCollection('projects'))
  .sort((a, b) => a.data.featured_order - b.data.featured_order);
---

<BaseLayout
  title="UX Case Studies - Jake Maisel Product Design Work"
  description="Explore detailed case studies showcasing UX research, product strategy, and design leadership. Featured work in automotive marketplace innovation, mobile design, and complex problem solving.">
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">Case studies</p>
      <h1>The <em>complete</em> work.</h1>
      <p class="lede">How I approached each problem, what I learned, and what changed as a result.</p>
    </div>
  </section>

  <section class="projects-section">
    <div class="container">

      {
        projects.length > 0 ? (
          <div class="projects-grid">
            {projects.map((project) => (
              <a href={`${baseUrl}projects/${project.slug}/`} class="project-card">
                {project.data.featured_image && (
                  <div class="project-image-wrapper">
                    <img
                      src={project.data.featured_image}
                      alt={project.data.title}
                      class="project-image"
                    />
                  </div>
                )}
                <div class="project-card-content">
                  <h3>{project.data.title}</h3>
                  <p class="summary">{project.data.summary}</p>
                  <div class="card-footer">
                    <span class="read-more">Read Case Study →</span>
                  </div>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="no-projects">
            <p>Projects coming soon...</p>
          </div>
        )
      }
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .projects-section {
    padding: 1rem 2rem 2rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: 14px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    background-color: var(--color-bg-secondary);
    transition: all 0.3s ease;
  }

  .project-card:hover {
    border-color: var(--gradient-start);
    box-shadow: 0 12px 32px rgba(var(--brand-blue-rgb), 0.15);
    transform: translateY(-2px);
  }

  .project-image-wrapper {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .project-image {
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    object-fit: cover;
    object-position: top;
  }

  .project-card-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    flex-grow: 1;
  }

  .project-card-content h3 {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 400;
    margin: 0;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .summary {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
    flex-grow: 1;
  }

  .card-footer {
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .read-more {
    font-size: 0.9rem;
    color: var(--color-accent);
    font-weight: 500;
    transition: transform 0.3s ease;
  }

  .project-card:hover .read-more {
    transform: translateX(2px);
  }

  @media (max-width: 1024px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .projects-section {
      padding: 1rem 1rem 2rem;
    }

    .projects-grid {
      grid-template-columns: 1fr;
    }
  }

  .no-projects {
    text-align: center;
    padding: 3rem;
    color: var(--color-text-subtle);
  }
</style>
