---
// src/pages/about.astro - About: one career across brand and product
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';

// Every fact below comes from the resumes; keep it that way.
const lanes = [
  {
    kind: 'Brand',
    title: 'Brands that hold up everywhere',
    items: [
      { n: '500+', h: 'Identity and systems', p: '500+ logos and identities, plus identity systems and brand guides for residential brands across Arizona, California, Texas and Utah.' },
      { n: '280+', h: 'Brands designed and led', p: 'I was the designer on 280+ brands, lead designer on most, and art director for the majority, from identities and launch campaigns to signage, print and web, each built to that brand’s voice. Flagship launches included Phoenix, Miami and Yonkers.' },
      { n: '800+', h: 'Motion and events', p: 'The Ryan’s launch video ads from storyboard to final cut, and event identities for ARCX (800+ attendees) and Marketing Masters.' },
      { n: '100s', h: 'Governance at scale', p: 'Reusable brand systems for hundreds of communities, and ACV’s first white-label system, so partner dealers keep their own brand inside one product.' },
    ],
  },
  {
    kind: 'Product',
    title: 'Products that keep the promise',
    items: [
      { n: '10×', h: 'Pricing and appraisal', p: 'Design lead on a 13-designer team. Grew Guaranteed Sale 10× in under a year after interviewing 25+ dealers.' },
      { n: '65%+', h: 'AI-powered products', p: 'Three years as lead designer on ClearCar, an AI trade-in platform. 65%+ of consumers who start its offer finish it.' },
      { n: '2 → 1', h: 'Strategy and research', p: 'Led the research behind 2025’s largest initiative, merging two products into one, and won buy-in from the CEO and board.' },
      { n: '4.2/5', h: 'Research that lands', p: 'New Car Pricing averaged 4.2 out of 5 for adoptability across 8 dealer groups. I design in code, with live Storybook prototypes instead of static mockups.' },
    ],
  },
];

const career = [
  { years: '2021 – 2026', role: 'Product Designer III, Lead Designer', org: 'ACV Auctions', line: 'Built and governed brands inside a product company, and led design for pricing, appraisal and AI products.' },
  { years: '2020 – 2021', role: 'Senior Marketing Associate', org: 'Greystar', line: 'Brand systems and templates for hundreds of communities, and the Marketing Masters 2021 identity.' },
  { years: '2018 – 2020', role: 'Senior Graphic Designer', org: 'Alliance Residential', line: 'Brand identities, launch key art, video and the ARCX conference. Grew high-value clients ~40%.' },
  { years: '2015 – 2018', role: 'Logo Specialist → Senior Designer', org: 'GoDaddy', line: 'Led a team of 6 logo designers, designed 500+ logos, and launched GoDaddy’s first self-service logo product.' },
];

const leadership = [
  { h: 'Lead the team', p: 'I ran GoDaddy’s 6-person logo team, mentored junior designers at ACV, and led a 12–14 person engineering team in India on ClearCar.' },
  { h: 'Win the room', p: 'At ACV I presented directly to the CEO of ACV MAX Digital and the board, and won buy-in to merge two products into one. It launched in June 2026.' },
  { h: 'Build what others reuse', p: 'For the white-label system I ran 3 workshops and wrote the brand guidelines. A 20+ week estimate came in under 10, and 3 more products reused it.' },
  { h: 'Own it end to end', p: 'For BidRev, everything but the name was mine: identity, style guide, messaging, website and go-to-market. A 4-week test lifted leads 3.5%.' },
  { h: 'Rescue the work', p: 'In my first week at Alliance I stepped in on Broadstone Osborn’s custom website, kept the client for years, and opened the door to bigger ones.' },
  { h: 'Put AI to work, carefully', p: 'I wrote ACV’s playbook for using Claude to create in-product guides, so any designer can move fast and stay on-brand.' },
];

const recognition = [
  { h: 'Luminary Award', p: 'GoDaddy, 2016' },
  { h: 'Rockstar Award, 3×', p: 'GoDaddy, quarterly' },
  { h: 'Stevie Award, team', p: 'Best Use of Technology in Customer Service, 2016' },
  { h: 'BA, Graphic & Web Design', p: 'The Art Institute of Phoenix' },
];
---

<BaseLayout
  title="About · Jake Maisel, Creative Director, Brand & Product"
  description="11+ years building brands and leading the product design that lives up to them: 500+ logos and identities, launches and campaigns, and products like Guaranteed Sale and ClearCar.">
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">About · Creative Director, Brand &amp; Product</p>
      <h1>A brand is only as good as the <em>last thing</em> it ships.</h1>
      <p class="lede">So I work on both sides. For 11+ years I’ve built brands and campaigns, then led the product design that has to live up to them.</p>
    </div>
  </section>

  <div class="container">
    <section class="intro">
      <img class="portrait" src="/images/jake-maisel.webp" alt="Jake Maisel" width="480" height="480" loading="eager" decoding="async" />
      <p>
        I started at GoDaddy designing logos, and ended up leading the team. At Alliance Residential and Greystar I built
        identities, launched buildings and ran conferences, all for brands that had to look right on a billboard, a website
        and a leasing-office wall. At ACV Auctions I did it inside a product company: building BidRev from the ground up,
        governing partner brands, and leading design for the pricing, appraisal and AI products dealers rely on.
      </p>
    </section>

    <section class="lanes" aria-label="What I lead">
      {lanes.map((lane) => (
        <div class="lane">
          <p class="lane-kind">{lane.kind}</p>
          <h2 class="section-title">{lane.title}</h2>
          <ul class="lane-list">
            {lane.items.map((it) => (
              <li class="lane-item">
                <span class="lane-n grad-text" aria-hidden="true">{it.n}</span>
                <h3>{it.h}</h3>
                <p>{it.p}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </section>

    <section class="career" aria-labelledby="career-title">
      <p class="eyebrow">Career</p>
      <h2 id="career-title" class="section-title">Eleven years, <em class="grad-text">one thread</em>.</h2>
      <ol class="timeline">
        {career.map((c) => (
          <li class="role">
            <span class="years">{c.years}</span>
            <div>
              <h3>{c.role} <span class="org">· {c.org}</span></h3>
              <p>{c.line}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="resumes">
        <a href="/resume-brand.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Brand resume</a>
        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Product design resume</a>
      </div>
    </section>

    <section class="lead-section" aria-labelledby="lead-title">
      <p class="eyebrow">Beyond the deliverable</p>
      <h2 id="lead-title" class="section-title">How I <em class="grad-text">lead</em>.</h2>
      <div class="lead-grid">
        {leadership.map((l, i) => (
          <article class="lead-item edge-card">
            <span class="lead-num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{l.h}</h3>
            <p>{l.p}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="recognition" aria-labelledby="rec-title">
      <h2 id="rec-title" class="section-title">Recognition</h2>
      <ul class="rec-list">
        {recognition.map((r) => (
          <li>
            <strong>{r.h}</strong>
            <span>{r.p}</span>
          </li>
        ))}
      </ul>
    </section>
  </div>

  <ContactCTA resume="/resume-brand.pdf" />
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  section + section {
    margin-top: 5.5rem;
  }

  .intro {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 2.5rem;
    align-items: center;
    padding-top: 1rem;
  }

  .portrait {
    width: 11rem;
    height: 11rem;
    margin: 0;
    border-radius: 50%;
    object-fit: cover;
    outline: 1px solid var(--image-outline);
    outline-offset: -1px;
    box-shadow: 0 0 0 6px var(--color-bg), 0 0 0 7px rgba(var(--glow-1-rgb), 0.45);
  }

  .intro p {
    font-size: clamp(1.15rem, 1.8vw, 1.35rem);
    line-height: 1.65;
    color: var(--color-text);
    max-width: 56ch;
    margin: 0;
  }

  /* Brand and product, side by side as equals */
  .lanes {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
  }

  .lane {
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .lane-kind {
    margin: 0 0 0.6rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .lane .section-title {
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    margin-bottom: 1.75rem;
  }

  .lane-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem;
  }

  /* Number first, so each column skims in seconds */
  .lane-item {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    column-gap: 1.25rem;
  }

  .lane-n {
    grid-row: span 2;
    font-family: var(--font-display);
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    padding-right: 0.05em;
  }

  .lane-item h3 {
    font-size: 1rem;
    margin-top: 0;
    font-weight: 600;
    color: var(--color-text);
    margin-bottom: 0.3rem;
  }

  .lane-item p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 48ch;
  }

  /* Career timeline */
  .career .section-title {
    margin-bottom: 2rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }

  .role {
    display: grid;
    grid-template-columns: 10rem 1fr;
    gap: 0.25rem 2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .years {
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
    padding-top: 0.35rem;
  }

  .role h3 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.2;
    margin: 0 0 0.3rem;
    color: var(--color-text);
  }

  .org {
    color: var(--color-text-muted);
  }

  .role p {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 64ch;
  }

  .resumes {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2rem;
  }

  /* How I lead */
  .lead-section .section-title {
    margin-bottom: 2rem;
  }

  .lead-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .lead-item {
    padding: 1.75rem;
  }

  .lead-num {
    display: block;
    font-family: var(--font-display);
    font-size: 2rem;
    line-height: 1;
    margin-bottom: 1rem;
    background: var(--gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }

  .lead-item h3 {
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 0.6rem;
  }

  .lead-item p {
    font-size: 0.95rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* Recognition */
  .recognition {
    margin-bottom: 4rem;
  }

  .recognition .section-title {
    margin-bottom: 1.5rem;
  }

  .rec-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-top: 1px solid var(--color-border);
  }

  .rec-list li {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 1.25rem 1.25rem 0 0;
  }

  .rec-list li + li {
    padding-left: 1.25rem;
    border-left: 1px solid var(--color-border);
  }

  .rec-list strong {
    font-weight: 600;
    color: var(--color-text);
  }

  .rec-list span {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  @media (max-width: 1024px) {
    .lead-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .rec-list {
      grid-template-columns: repeat(2, 1fr);
    }

    .rec-list li,
    .rec-list li + li {
      padding: 1.1rem 1rem 1.1rem 0;
      border-left: 0;
    }

    .rec-list li:nth-child(even) {
      padding-left: 1rem;
      border-left: 1px solid var(--color-border);
    }

    .rec-list li:nth-child(n + 3) {
      border-top: 1px solid var(--color-border);
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }

    section + section {
      margin-top: 4rem;
    }

    .lanes,
    .lead-grid {
      grid-template-columns: 1fr;
    }

    .role {
      grid-template-columns: 1fr;
    }

    .intro {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .portrait {
      width: 7rem;
      height: 7rem;
    }

    .lane-item {
      grid-template-columns: 5rem 1fr;
      column-gap: 1rem;
    }

    .lane-n {
      font-size: 1.9rem;
    }

    .years {
      padding-top: 0;
    }

    .role h3 {
      font-size: 1.35rem;
    }
  }
</style>
