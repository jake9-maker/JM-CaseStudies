---
// src/pages/index.astro - Homepage
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactCTA from '../components/ContactCTA.astro';
import { getCollection } from 'astro:content';

const baseUrl = import.meta.env.BASE_URL;

// Headline outcomes shown beside the hero, one per featured case study
const outcomes = [
  { slug: 'project-1', name: 'Guaranteed Sale', metric: '10×', what: 'growth by building guarantees into the auction flow' },
  { slug: 'project-2', name: 'Market Report', metric: '100%', what: 'mobile utility for dealers on the lot, not just the office' },
  { slug: 'new-car-pricing', name: 'New Car Workflow', metric: 'Auditable', what: 'pricing decisions, shipped on deadline' },
];

// Fetch featured projects and sort by featured_order
const allProjects = await getCollection('projects');
const projects = allProjects
  .filter(project => project.data.featured)
  .sort((a, b) => a.data.featured_order - b.data.featured_order);
---

<BaseLayout
  title="JM Case Studies - Product Design & Leadership"
  description="Senior UX/Product Designer specializing in complex problem solving, strategic product design, and cross-functional leadership. View my case studies in automotive marketplace innovation.">
  <section class="hero">
    <div class="hero-content">
      <div class="hero-copy" data-parallax style="--parallax-speed: 0.12">
        <p class="eyebrow">Jake Maisel · Senior Product Designer</p>
        <h1 class="display">Complex workflows, made <em>trustworthy</em>.</h1>
        <p class="tagline">
          I turn compliance-heavy, multi-step processes—pricing, approvals, auctions—into tools operations teams rely on.
        </p>
        <div class="hero-actions">
          <a href="#work" class="btn btn-primary">See the work</a>
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View resume</a>
        </div>
      </div>

      <div class="outcomes edge-card" data-parallax style="--parallax-speed: -0.08" aria-label="Selected outcomes">
        {outcomes.map((o) => (
          <a href={`${baseUrl}projects/${o.slug}/`} class="outcome">
            <span class="outcome-name">{o.name}</span>
            <span class="outcome-metric grad-text">{o.metric}</span>
            <span class="outcome-arrow" aria-hidden="true">→</span>
            <span class="outcome-what">{o.what}</span>
          </a>
        ))}
        <div class="outcomes-foot">
          <span>{outcomes.length} selected case studies</span>
          <span class="ok">● fewer disputes, less risk</span>
        </div>
      </div>
    </div>
  </section>

  <section class="featured-projects" id="work">
    <div class="container">
      <p class="eyebrow">Featured work</p>
      <h2 class="section-title">Problems worth <em class="grad-text">solving</em>.</h2>
      <p class="section-intro">
        How I frame problems, research them, and lead teams to ship.
      </p>

      <div class="projects-grid">
        {projects.map((project) => (
          <a href={`${baseUrl}projects/${project.slug}/`} class="project-card">
            {project.data.featured_image && (
              <div class="project-image">
                <img src={project.data.featured_image} alt={project.data.title} loading="lazy" />
              </div>
            )}
            <div class="project-content">
              <h3>{project.data.title}</h3>
              <p class="project-summary">{project.data.summary}</p>
              <span class="read-more">Read case study →</span>
            </div>
          </a>
        ))}
        <a href={`${baseUrl}projects/`} class="project-card view-all-card">
          <div class="view-all-inner">
            <p class="eyebrow">More case studies</p>
            <h3 class="display">View all <em>work</em></h3>
            <p class="project-summary">Every case study, from first research to what shipped.</p>
            <span class="view-all-arrow" aria-hidden="true">→</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <ContactCTA />
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding: 5rem 2rem 6.5rem;
    background: var(--color-bg);
  }

  /* Soft signature-gradient glow */
  .hero::before {
    content: "";
    position: absolute;
    width: 720px;
    height: 720px;
    right: -160px;
    top: -200px;
    background: radial-gradient(closest-side, rgba(var(--brand-blue-rgb), 0.32), rgba(var(--brand-teal-rgb), 0.12) 55%, transparent);
    pointer-events: none;
  }

  .hero-content {
    position: relative;
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .hero-copy h1 {
    font-size: clamp(3.1rem, 7vw, 5.75rem);
    line-height: 1;
    margin: 0;
  }

  .tagline {
    font-size: 1.2rem;
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 36ch;
    margin: 1.6rem 0 0;
  }

  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 2.25rem;
  }

  /* Outcomes panel */
  .outcomes {
    padding: 0.5rem;
  }

  .outcome {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.15rem 1.25rem;
    align-items: center;
    padding: 1.25rem;
    border-radius: 8px;
    text-decoration: none;
    color: inherit;
  }

  .outcome + .outcome {
    border-top: 1px solid var(--color-border);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
  }

  .outcome:hover {
    background: var(--color-bg-tertiary);
  }

  .outcome-name {
    grid-column: 1 / -1;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .outcome-metric {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2.75rem;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .outcome-arrow {
    grid-row: 2 / span 2;
    grid-column: 2;
    font-size: 1.25rem;
    color: var(--color-accent);
  }

  .outcome-what {
    font-size: 0.9rem;
    line-height: 1.45;
    color: var(--color-text-muted);
    max-width: 30ch;
  }

  .outcomes-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1.25rem 0.75rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .outcomes-foot .ok {
    color: var(--color-success);
  }

  @media (max-width: 860px) {
    .hero {
      padding: 3rem 1rem 4.5rem;
    }

    .hero-content {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .hero::before {
      width: 420px;
      height: 420px;
      right: -180px;
      top: -100px;
    }

    .tagline {
      font-size: 1.1rem;
    }
  }

  .featured-projects {
    padding: 4rem 2rem;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .section-intro {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    margin: 0 0 3rem;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .project-card:hover {
    border-color: var(--gradient-start);
    box-shadow: 0 12px 32px rgba(var(--brand-blue-rgb), 0.15);
    transform: translateY(-2px);
  }

  .project-image {
    width: 100%;
    height: 200px;
    overflow: hidden;
    background-color: var(--color-bg-tertiary);
  }

  .project-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .view-all-card {
    position: relative;
    justify-content: flex-end;
    min-height: 100%;
    background:
      radial-gradient(120% 80% at 100% 0%, rgba(var(--brand-blue-rgb), 0.28), transparent 60%),
      radial-gradient(90% 70% at 0% 100%, rgba(var(--brand-teal-rgb), 0.18), transparent 60%),
      var(--color-bg-secondary);
  }

  .view-all-inner {
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    height: 100%;
    justify-content: flex-end;
  }

  .view-all-inner .eyebrow {
    margin-bottom: auto;
  }

  .view-all-inner h3 {
    font-size: clamp(2.5rem, 5vw, 3.5rem);
    margin: 2rem 0 0;
  }

  .view-all-arrow {
    align-self: flex-start;
    margin-top: 0.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: var(--gradient-button);
    color: #fff;
    font-size: 1.25rem;
    transition: transform 0.3s ease;
  }

  .view-all-card:hover .view-all-arrow {
    transform: translateX(4px);
  }

  .project-content {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-content h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    font-weight: 400;
    margin: 0;
    color: var(--color-text);
    line-height: 1.15;
    letter-spacing: -0.01em;
  }

  .project-summary {
    font-size: 0.9rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .read-more {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-accent);
  }

  @media (max-width: 768px) {
    .projects-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
