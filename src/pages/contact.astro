---
// src/pages/contact.astro - Contact page
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
  title="Contact Jake Maisel - Let's Connect"
  description="Get in touch to discuss your next product design project. Connect via email, LinkedIn, or download my resume to learn more.">
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">Contact</p>
      <h1>Let's <em>connect</em>.</h1>
      <p class="lede">
        I'm always interested in discussing new projects, design challenges, and opportunities to work together.
      </p>
    </div>
  </section>

  <section class="contact-page">
    <div class="container">

      <div class="contact-info">
        <div class="info-card email-card edge-card">
          <div class="info-header">
            <h3>Email</h3>
            <span class="timezone-badge">US Eastern Time</span>
          </div>
          <p class="contact-email">
            <a href="mailto:jake@maiseldesigns.com" class="grad-text">jake@maiseldesigns.com</a>
          </p>
          <p class="contact-description">
            The best way to reach me. I typically reply within 24 hours.
          </p>
        </div>
      </div>

      <div class="contact-methods">
        <a href="https://www.linkedin.com/in/jake-maisel-33970197/" target="_blank" rel="noopener noreferrer" class="contact-item">
          <div class="contact-item-header">
            <h3>LinkedIn</h3>
          </div>
          <p class="contact-title">Jake Maisel</p>
          <p class="contact-description">
            Connect with me to stay updated on my latest work and insights.
          </p>
        </a>

        <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="contact-item">
          <div class="contact-item-header">
            <h3>Resume</h3>
          </div>
          <p class="contact-title">Download PDF</p>
          <p class="contact-description">
            Full background, experience, and professional history.
          </p>
        </a>
      </div>

      <div class="cta-section edge-card">
        <h2 class="display">Let's discuss your next <em>project</em>.</h2>
        <p>
          Whether you have a specific challenge in mind or want to explore how strategic design can solve your problems, I'm ready to have that conversation.
        </p>
        <a href="mailto:jake@maiseldesigns.com?subject=Let%27s%20work%20together" class="btn btn-primary">Start the conversation</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-page {
    padding: 1rem 2rem 2rem;
  }

  .container {
    max-width: 720px;
    margin: 0 auto;
  }

  .contact-info {
    margin-bottom: 3rem;
  }

  .info-card {
    padding: 2rem;
  }

  .info-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .info-header h3 {
    font-size: 1.3rem;
    margin: 0;
    font-weight: 600;
  }

  .timezone-badge {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    background-color: var(--color-bg-tertiary);
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-weight: 500;
  }

  .contact-email {
    margin: 1rem 0;
  }

  .contact-email a {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 400;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition: text-decoration 0.2s ease;
  }

  .contact-email a:hover {
    text-decoration: underline;
  }

  .contact-methods {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 4rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: all 0.3s ease;
  }

  .contact-item:hover {
    border-color: var(--gradient-start);
    box-shadow: 0 12px 32px rgba(var(--brand-blue-rgb), 0.15);
    transform: translateY(-2px);
  }

  .contact-item-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .contact-item h3 {
    font-family: var(--font-display);
    font-size: 1.75rem;
    margin: 0;
    color: var(--color-text);
    font-weight: 400;
  }

  .contact-icon {
    flex-shrink: 0;
    color: var(--color-accent);
    transition: color 0.3s ease, transform 0.3s ease;
  }

  .contact-item:hover .contact-icon {
    color: var(--color-accent-dark);
    transform: translateX(2px);
  }

  .contact-title {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-text);
    margin: 0;
  }

  .contact-item p {
    margin: 0;
    line-height: 1.6;
  }

  .contact-description {
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 768px) {
    .contact-methods {
      grid-template-columns: 1fr;
    }
  }

  .cta-section {
    padding: 3rem 2rem;
    text-align: center;
  }

  .cta-section h2 {
    font-size: clamp(2rem, 4.5vw, 2.75rem);
    margin: 0 0 1rem;
  }

  .cta-section p {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0 auto 2rem;
    line-height: 1.7;
    max-width: 48ch;
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: 1rem 1rem 2rem;
    }

    .cta-section {
      padding: 2.5rem 1.25rem;
    }
  }
</style>
