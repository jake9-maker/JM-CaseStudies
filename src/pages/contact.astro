---
// src/pages/contact.astro - Contact page
import BaseLayout from '../layouts/BaseLayout.astro';

---

<BaseLayout
  title="Contact · Jake Maisel, Creative Director, Brand & Product"
  description="Get in touch with Jake Maisel about brand leadership, creative direction and product design. Based in Buffalo, NY, open to remote.">
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">Contact</p>
      <h1>Let's <em>connect</em>.</h1>
      <p class="lede">
        Building a brand team, launching something new, or need brand and product to finally tell the same story? I'd like to hear about it.
      </p>
    </div>
  </section>

  <section class="contact-page">
    <div class="container contact-grid">
      <div class="edge-card email-card">
        <div class="info-header">
          <h2>Email</h2>
          <span class="timezone-badge">Buffalo, NY · US Eastern</span>
        </div>
        <p class="contact-email">
          <a href="mailto:jake@maiseldesigns.com" class="grad-text">jake@maiseldesigns.com</a>
        </p>
        <p class="contact-description">
          The best way to reach me. I typically reply within 24 hours, and I'm open to remote.
        </p>
        <div class="email-actions">
          <a href="mailto:jake@maiseldesigns.com" class="btn btn-primary">Email me</a>
          <button type="button" class="copy-btn" data-copy="jake@maiseldesigns.com">
            <span class="copy-label">Copy email</span>
          </button>
        </div>
      </div>

      <a href="https://www.linkedin.com/in/jake-maisel-33970197/" target="_blank" rel="noopener noreferrer" class="edge-card side-card link-card">
        <div class="side-head">
          <h2>LinkedIn</h2>
          <span class="arrow" aria-hidden="true">↗</span>
        </div>
        <p class="contact-description">My career in one place, and the quickest way to connect.</p>
      </a>

      <div class="edge-card side-card">
        <div class="side-head">
          <h2>Resumes</h2>
        </div>
        <p class="contact-description">One for brand and creative leadership, one for product design.</p>
        <div class="resume-links">
          <a href="/resume-brand.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-primary">Brand resume</a>
          <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">Product resume</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Copy the email address, and say so in the button itself (not just motion)
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const label = btn.querySelector('.copy-label');
    let timer: number | undefined;
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy || '');
        if (label) label.textContent = 'Copied';
        btn.classList.add('copied');
      } catch {
        // Clipboard blocked: highlight the address so a manual copy just works
        const email = document.querySelector('.contact-email a');
        const sel = window.getSelection();
        if (email && sel) {
          const range = document.createRange();
          range.selectNodeContents(email);
          sel.removeAllRanges();
          sel.addRange(range);
        }
        if (label) label.textContent = 'Selected, press ⌘C';
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = 'Copy email';
        btn.classList.remove('copied');
      }, 2000);
    });
  });
</script>

<style>
  .contact-page {
    padding: 0.5rem 2rem 5rem;
  }

  /* Same width and left edge as the headline above */
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  /* Email leads on the left; LinkedIn and resumes stack beside it */
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    grid-template-rows: auto auto;
    gap: 1.5rem;
  }

  .email-card {
    grid-row: 1 / span 2;
    display: flex;
    flex-direction: column;
    padding: 2.5rem;
  }

  .info-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .info-header h2,
  .side-head h2 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.75rem;
    line-height: 1.1;
    margin: 0;
    color: var(--color-text);
  }

  .timezone-badge {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-text-muted);
    background-color: var(--color-bg-tertiary);
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
  }

  .contact-email {
    margin: auto 0 0.75rem;
    padding-top: 2.5rem;
  }

  .contact-email a {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4.4vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact-email a:hover {
    text-decoration: underline;
  }

  .email-actions {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1.75rem;
  }

  .copy-btn {
    appearance: none;
    font: inherit;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.2;
    padding: 0.8rem 1.5rem;
    border-radius: 9999px;
    border: 1px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    transition: border-color 0.2s ease-out, color 0.2s ease-out, transform 0.2s ease-out;
  }

  .copy-btn:hover {
    border-color: var(--gradient-start);
  }

  .copy-btn:active {
    transform: scale(0.96);
  }

  .copy-btn.copied {
    border-color: var(--color-success);
    color: var(--color-success);
  }

  .copy-btn:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }

  .side-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 2rem;
    color: inherit;
    text-decoration: none;
  }

  .side-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .link-card {
    transition: transform 0.2s ease-out, box-shadow 0.2s ease-out;
  }

  .link-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 36px -18px rgba(var(--glow-1-rgb), 0.45);
  }

  .link-card:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  .arrow {
    color: var(--color-accent);
    font-size: 1.25rem;
    transition: transform 0.2s ease-out;
  }

  .link-card:hover .arrow {
    transform: translate(2px, -2px);
  }

  .resume-links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 0.5rem;
  }

  .contact-description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 44ch;
  }

  @media (max-width: 860px) {
    .contact-grid {
      grid-template-columns: 1fr;
    }

    .email-card {
      grid-row: auto;
      padding: 2rem;
    }

    .contact-email {
      padding-top: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .contact-page {
      padding: 0.5rem 1rem 4rem;
    }

    .email-card,
    .side-card {
      padding: 1.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .link-card:hover,
    .link-card:hover .arrow {
      transform: none;
    }
  }
</style>
