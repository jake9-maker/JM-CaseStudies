---
// ContactCTA.astro - Reusable contact call-to-action component
---

<section class="contact-cta">
  <div class="cta-content edge-card">
    <h2 class="display">Ready to work <em>together</em>?</h2>
    <p>Let's talk about the complex problem your team is trying to solve.</p>
    <div class="cta-actions">
      <a href="mailto:jake@maiseldesigns.com" class="btn btn-primary">Get in touch</a>
      <a href="/resume.pdf" target="_blank" rel="noopener noreferrer" class="btn btn-ghost">View resume</a>
    </div>
  </div>
</section>

<style>
  .contact-cta {
    padding: 4rem 2rem 2rem;
  }

  .cta-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3.5rem 2rem;
    text-align: center;
    overflow: hidden;
  }

  .cta-content::after {
    content: "";
    position: absolute;
    width: 560px;
    height: 560px;
    left: 50%;
    top: -300px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(var(--brand-blue-rgb), 0.22), rgba(var(--brand-teal-rgb), 0.08) 55%, transparent);
    pointer-events: none;
  }

  .cta-content h2 {
    position: relative;
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    margin: 0 0 1rem;
  }

  .cta-content p {
    position: relative;
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin: 0 auto 2rem;
    max-width: 44ch;
  }

  .cta-actions {
    position: relative;
    display: flex;
    gap: 0.75rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  @media (max-width: 768px) {
    .contact-cta {
      padding: 3rem 1rem 1rem;
    }

    .cta-content {
      padding: 2.5rem 1.25rem;
    }
  }
</style>
