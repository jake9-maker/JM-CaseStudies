.097 435.199 238.778 435.199C246.549 435.199 255.930 440.377 257.895 451.905L219.751 451.905M264.329 455.745C264.329 451.459 263.346 446.719 260.481 442.078C256.996 436.001 249.407 429.658 238.687 429.567C224.483 429.839 213.318 441.451 213.318 455.292C213.318 469.768 225.110 480.850 238.778 480.850C250.034 480.850 259.415 473.427 262.809 463.698L256.195 463.698C253.965 469.768 247.622 475.037 238.687 475.218C229.132 475.218 220.197 467.085 219.751 457.530L264.238 457.530C264.238 456.902 264.329 456.372 264.329 455.745"/><path class="logo-ink" d="M353.467 436.451C356.234 432.073 361.057 429.572 366.772 429.572C373.832 429.572 379.819 432.966 383.213 438.953C387.053 432.785 392.678 429.572 399.648 429.572C411.175 429.572 419.218 437.615 419.218 450.655L419.218 479.682L412.959 479.682L412.959 451.366C412.959 440.918 407.955 435.195 399.648 435.195C391.340 435.195 386.336 440.918 386.336 451.366L386.336 479.682L380.084 479.682L380.084 451.366C380.084 440.918 375.080 435.195 366.772 435.195C358.464 435.195 353.467 440.918 353.467 451.366L353.467 479.682L347.208 479.682L347.208 430.819L353.467 430.819L353.467 436.451"/><path class="logo-ink" d="M469.470 475.217C457.503 475.217 449.460 466.289 449.460 455.396C449.460 442.969 458.744 435.198 469.470 435.198C480.726 435.198 489.034 444.572 489.034 455.298C489.034 466.728 480.008 475.217 469.470 475.217M488.678 430.822L488.678 439.393L488.497 439.393C483.312 431.275 474.739 429.566 469.470 429.566C453.475 429.566 443.209 442.078 443.209 455.125C443.209 469.146 454.102 480.849 469.470 480.849C474.565 480.849 483.137 479.148 488.497 471.112L488.678 471.112L488.678 479.685L494.930 479.685L494.930 430.822L488.678 430.822"/><path class="logo-ink" d="M520.608 430.824H526.853V479.688H520.608Z"/><path class="logo-ink" d="M555.373 465.211C555.554 474.508 561.897 475.219 564.127 475.219C570.023 475.219 573.243 471.735 573.243 466.459C573.243 459.761 567.166 458.241 563.500 456.729C558.502 455.028 550.550 452.352 550.550 443.152C550.550 436.266 555.464 429.568 564.482 429.568C571.724 429.568 577.794 435.109 577.794 442.706L577.794 442.880L571.542 442.880C571.096 436.894 566.991 435.200 564.217 435.200C559.220 435.200 556.802 439.221 556.802 442.525C556.802 447.703 561.987 449.495 565.556 450.658C571.278 452.526 579.495 455.649 579.495 465.748L579.495 465.929C579.495 474.237 574.400 480.851 564.127 480.851C557.429 480.851 549.121 476.383 549.121 465.748L549.121 465.211L555.373 465.211"/><path class="logo-ink" d="M605.783 451.905C607.568 440.377 617.123 435.199 624.810 435.199C632.581 435.199 641.962 440.377 643.928 451.905L605.783 451.905M650.361 455.745C650.361 451.459 649.378 446.719 646.513 442.078C643.028 436.001 635.446 429.658 624.720 429.567C610.515 429.839 599.343 441.451 599.343 455.292C599.343 469.768 611.143 480.850 624.810 480.850C636.066 480.850 645.447 473.427 648.841 463.698L642.227 463.698C639.990 469.768 633.655 475.037 624.720 475.218C615.164 475.218 606.229 467.085 605.783 457.530L650.270 457.530C650.270 456.902 650.361 456.372 650.361 455.745"/><path class="logo-ink" d="M674.162 413.588H680.414V479.688H674.162Z"/></svg>
      </a>
    </div>
    <div class="nav-wrapper">
      <nav>
        <ul class="nav-links">
          <li><a href={`${baseUrl}about/`} class={isActive(`${baseUrl}about/`) ? 'active' : ''}>About</a></li>
          <li><a href={`${baseUrl}projects/`} class={isActive(`${baseUrl}projects/`) ? 'active' : ''}>Projects</a></li>
          <li><a href={`${baseUrl}contact/`} class={`btn btn-primary nav-cta${isActive(`${baseUrl}contact/`) ? ' active' : ''}`}><span class="cta-long">Get in touch</span><span class="cta-short">Contact</span></a></li>
        </ul>
      </nav>
      <ThemeToggle />
    </div>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');

  function updateHeaderTransparency() {
    if (window.scrollY > 0) {
      header?.classList.add('scrolled');
    } else {
      header?.classList.remove('scrolled');
    }
  }

  // Check on initial load
  updateHeaderTransparency();

  // Listen for scroll events
  window.addEventListener('scroll', updateHeaderTransparency, { passive: true });
</script>

<style>
  .skip-link {
    position: absolute;
    top: -40px;
    left: 0;
    background: var(--color-accent);
    color: white;
    padding: 0.5rem 1rem;
    text-decoration: none;
    border-radius: 0 0 8px 0;
    z-index: 1000;
  }

  .skip-link:focus {
    top: 0;
  }

  header {
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
    padding: 1rem 0;
    transition: background-color 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease;
    position: sticky;
    top: 0;
    z-index: 100;
  }

  header.scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 95%, transparent);
    border-bottom-color: color-mix(in srgb, var(--color-border) 50%, transparent);
    backdrop-filter: blur(10px);
  }

  .container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .nav-brand {
    flex-shrink: 0;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    text-decoration: none;
  }

  .brand-mark {
    height: 42px;
    width: auto;
    display: block;
  }

  .brand-word {
    height: 17px;
    width: auto;
    display: block;
  }

  .logo-ink {
    fill: var(--color-text);
  }

  .logo-stop-end {
    stop-color: #0aa697;
  }

  :global(html[data-theme="dark"]) .logo-stop-end {
    stop-color: #12d6c5;
  }

  .nav-wrapper {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-left: auto;
  }

  nav {
    display: flex;
    align-items: center;
  }

  .nav-links {
    list-style: none;
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    align-items: center;
  }

  .nav-links a:not(.nav-cta) {
    text-decoration: none;
    color: var(--color-text-muted);
    font-weight: 500;
    font-size: 0.95rem;
    transition: color 0.3s ease;
    white-space: nowrap;
  }

  .nav-links a:not(.nav-cta):hover,
  .nav-links a.active:not(.nav-cta) {
    color: var(--color-text);
  }

  .nav-links a.nav-cta {
    padding: 0.55rem 1.1rem;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .cta-short {
    display: none;
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1rem;
    }

    .header-inner {
      gap: 1rem;
    }

    .nav-wrapper {
      gap: 0.75rem;
    }

    .brand-word {
      display: none;
    }

    .brand-mark {
      height: 28px;
    }

    .nav-links {
      gap: 0.9rem;
    }

    .nav-links a:not(.nav-cta) {
      font-size: 0.9rem;
    }

    .nav-links a.nav-cta {
      padding: 0.45rem 0.9rem;
      font-size: 0.85rem;
    }

    .cta-long {
      display: none;
    }

    .cta-short {
      display: inline;
    }
  }
</style>
