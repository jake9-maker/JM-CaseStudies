---
// WorkMarquee.astro - One slow row of brand marks, like a wall of clients.
// Same-size squares, no captions. Each tile links to that brand's page.
// Pauses on hover or keyboard focus; becomes a still, swipeable row for reduced motion.
const baseUrl = import.meta.env.BASE_URL;

type Tile = { slug: string; title: string };

const tiles: Tile[] = [
  { slug: 'broadstone-grand', title: 'Broadstone Grand' },
  { slug: 'bidrev', title: 'BidRev' },
  { slug: 'the-ryan', title: 'The Ryan' },
  { slug: 'persea', title: 'Persea' },
  { slug: 'broadstone-paragon', title: 'Broadstone Paragon' },
  { slug: 'elements616', title: 'Elements616' },
  { slug: 'entrada', title: 'Entrada' },
  { slug: 'logo-design', title: 'Logo design' },
  { slug: 'the-drexel-collective', title: 'The Drexel Collective' },
  { slug: 'broadstone-rio-salado', title: 'Broadstone Rio Salado' },
  { slug: 'revo', title: 'Revo' },
  { slug: '21lux', title: '21LUX' },
];
---

<section class="marquee" aria-label="A sample of brands I've built and launched">
  <div class="row">
    <div class="track">
      {[0, 1].map((copy) => (
        <div class="set" aria-hidden={copy === 1 ? 'true' : undefined}>
          {tiles.map((t) => (
            <a
              href={`${baseUrl}brand/${t.slug}/`}
              class="tile"
              aria-label={t.title}
              tabindex={copy === 1 ? -1 : undefined}
            >
              <img src={`/images/marquee/${t.slug}.webp`} alt="" width="480" height="480" loading="lazy" decoding="async" />
            </a>
          ))}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .marquee {
    --tile-h: 11.25rem;
    --gap: 1rem;
      padding: 0.5rem 0;
    overflow: hidden;
    /* Tiles fade in and out at the edges instead of being cut off */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .row {
    overflow: hidden;
  }

  .track {
    display: flex;
    width: max-content;
  }

  .set {
    display: flex;
    gap: var(--gap);
    padding-right: var(--gap);
  }

  .tile {
    position: relative;
    flex: none;
    height: var(--tile-h);
    aspect-ratio: 1 / 1;
    /* Concentric-friendly: one radius, no nested surfaces */
    border-radius: 12px;
    overflow: hidden;
    background: var(--color-bg-tertiary);
    box-shadow:
      0 1px 2px rgba(var(--glow-2-rgb), 0.08),
      0 12px 32px -18px rgba(var(--glow-2-rgb), 0.35);
    transition: transform 0.25s ease-out, box-shadow 0.25s ease-out;
  }

  /* Hairline edge drawn on top so it sits over the image, not under it */
  .tile::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--image-outline);
    pointer-events: none;
  }

  .tile img {
    display: block;
    width: 100%;
    height: 100%;
    margin: 0;
    border-radius: 0;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.2, 0, 0, 1);
  }

  .tile:hover {
    transform: translateY(-3px);
    box-shadow:
      0 1px 2px rgba(var(--glow-1-rgb), 0.1),
      0 20px 40px -18px rgba(var(--glow-1-rgb), 0.45);
  }

  .tile:hover img {
    transform: scale(1.04);
  }

  .tile:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      animation: slide 60s linear infinite;
    }

    /* Hover or tab into a row and it holds still */
    .row:hover .track,
    .row:focus-within .track {
      animation-play-state: paused;
    }
  }

  @keyframes slide {
    to { transform: translate3d(-50%, 0, 0); }
  }

  /* Motion off: one still row you can swipe or scroll sideways */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      -webkit-mask-image: none;
      mask-image: none;
    }

    .row {
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding: 0 1rem;
    }

    .set[aria-hidden='true'] {
      display: none;
    }

    .tile {
      scroll-snap-align: start;
    }

    .tile:hover,
    .tile:hover img {
      transform: none;
    }
  }

  @media (max-width: 768px) {
    .marquee {
      --tile-h: 8.5rem;
      --gap: 0.75rem;
    }
  }
</style>
